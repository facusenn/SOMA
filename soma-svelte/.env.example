# Key de OpenRouter (https://openrouter.ai/keys). Sin key la app corre en modo demo.
OPENROUTER_API_KEY=
# Modelo para registrar eventos y leer estudios (rápido)
OPENROUTER_MODEL_FAST=anthropic/claude-haiku-5.5
# Modelo para el análisis de posibles problemas
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
